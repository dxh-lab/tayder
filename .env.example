# Discord
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
# Comma-separated Discord user IDs allowed to Approve/Skip/kill
DISCORD_ALLOWLIST_USER_IDS=

# Mode: paper (default) | live
MODE=paper

# Bankroll hard cap (USD). Paper ≤ 100; live ≤ 10.
BANKROLL_USD=100

# Risk
MAX_OPEN_POSITIONS=1
MIN_NOTIONAL_USD=1.0
COOLDOWN_SECONDS=300
DAILY_LOSS_STOP_PCT=0.25
# Refuse BUY proposals when round-trip fees would dominate distance-to-mean.
# Paper defaults to advisory (false): Discord still gets Approve/Skip, with a
# cost warning on the embed. Live defaults to true. Override explicitly:
# ENFORCE_FEE_DOMINANCE=true|false
FEE_DOMINANCE_BPS=20
TAKER_FEE_BPS=60
MAKER_FEE_BPS=25

# Proposal expiry (seconds) before Approve/Skip is ignored
PROPOSAL_EXPIRY_SECONDS=300

# Strategy (15m mean-reversion). Discord notifies only on a fresh z-entry cross,
# not on every continuation bar, so you are not re-pinged for the same setup.
STRATEGY_PAIRS=BTC-USD,ETH-USD
STRATEGY_LOOKBACK=20
STRATEGY_Z_ENTRY=1.5
CANDLE_GRANULARITY_SECONDS=900
POLL_INTERVAL_SECONDS=60

# Journal
JOURNAL_DB_PATH=./data/tayder.db

# Coinbase Advanced Trade (CDP API key — view + trade only; NEVER enable transfer)
# Key name looks like: organizations/.../apiKeys/...
COINBASE_API_KEY_NAME=
# PEM private key (literal, newlines as \n) OR path via COINBASE_API_KEY_FILE
COINBASE_API_PRIVATE_KEY=
COINBASE_API_KEY_FILE=
COINBASE_API_BASE=https://api.coinbase.com

# Final execution checks (basis points: 100 bps = 1%)
MAX_SPREAD_BPS=50
MAX_PRICE_DRIFT_BPS=50
MAX_BOOK_AGE_SECONDS=60
# Adverse slippage per side: used by cost gate and paper fills
SLIPPAGE_BPS=10
