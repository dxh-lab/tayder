# Discord
DISCORD_TOKEN=
DISCORD_CHANNEL_ID=
# Comma-separated Discord user IDs allowed to Approve/Skip/kill
DISCORD_ALLOWLIST_USER_IDS=

# Mode: paper (default) | live
MODE=paper

# Bankroll hard cap (USD). Keep ≤ 10.
BANKROLL_USD=10

# Risk
MAX_OPEN_POSITIONS=1
MIN_NOTIONAL_USD=1.0
COOLDOWN_SECONDS=300
DAILY_LOSS_STOP_PCT=0.25
# Refuse if round-trip fees would dominate expected edge
FEE_DOMINANCE_BPS=20
TAKER_FEE_BPS=60
MAKER_FEE_BPS=25

# Proposal expiry (seconds) before Approve/Skip is ignored
PROPOSAL_EXPIRY_SECONDS=300

# Strategy
STRATEGY_PAIRS=BTC-USD,ETH-USD
CANDLE_GRANULARITY_SECONDS=900
POLL_INTERVAL_SECONDS=60

# Journal
JOURNAL_DB_PATH=./data/tayder.db

# Coinbase Advanced Trade (CDP API key — view + trade only; NEVER enable transfer)
# Key name looks like: organizations/.../apiKeys/...
COINBASE_API_KEY_NAME=
# PEM private key (literal, newlines as \n) OR path via COINBASE_API_KEY_FILE
COINBASE_API_PRIVATE_KEY=
COINBASE_API_KEY_FILE=
COINBASE_API_BASE=https://api.coinbase.com
